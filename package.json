{
  "name": "pwap",
  "version": "1.0.0",
  "private": true,
  "description": "Pezkuwi Web App Projects - Monorepo",
  "scripts": {
    "build": "npm run build:web && npm run build:sign",
    "build:web": "cd web && npm run build",
    "build:sign": "cd sign && npm run build",
    "dev:web": "cd web && npm run dev",
    "install:all": "npm run install:web && npm run install:sign && npm run install:backend",
    "install:web": "cd web && npm install",
    "install:sign": "cd sign && npm install",
    "install:backend": "cd backend && npm install",
    "lint": "cd web && npm run lint",
    "test": "npm run test:web && npm run test:backend",
    "test:web": "cd web && npm run test",
    "test:backend": "cd backend && npm test"
  }
}
